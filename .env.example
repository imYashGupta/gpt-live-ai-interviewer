OPENAI_API_KEY=
APP_PASSCODE=
# Original demo app and passcode lockouts; defaults to .data/interviews.sqlite. Keep it on persistent storage.
SQLITE_DATABASE_PATH=.data/interviews.sqlite

# Independent interview service: opt-in, synthetic provider, zero billable usage.
INTERVIEW_SERVICE_ENABLED=false
# Use a dedicated database on your existing Herd PostgreSQL server.
INTERVIEW_DATABASE_URL=
# Generate 32 random bytes as 64 hex characters; keep stable across API/worker restarts.
INTERVIEW_SERVICE_ENCRYPTION_KEY=
INTERVIEW_SERVICE_ORIGIN=https://interviewer.test
# Optional: restrict webhook delivery to these exact hostnames, comma-separated; no wildcards. Empty allows any
# operator-registered endpoint. Production requires public HTTPS.
# Development/test may use allowlisted HTTP, localhost, .test and private IPv4 destinations.
INTERVIEW_WEBHOOK_HOSTS=
# Optional separate test database on the SAME server; tests use a temporary schema.
INTERVIEW_TEST_DATABASE_URL=

# Real OpenAI interviews for every client account. Both API and worker need identical settings and OPENAI_API_KEY.
# When false, new interviews use the synthetic provider and new live starts are refused.
INTERVIEW_LIVE_ENABLED=false
# Leave capacity for assessment and delivery while live capture runs.
INTERVIEW_WORKER_CONCURRENCY=4

# Interview video recording (in progress on feat/interview-video-recording). The browser uploads straight to this
# private bucket through short-lived links; media never passes through the app or worker. Setup: INTERVIEW_SERVICE_SETUP.md.
INTERVIEW_RECORDING_ENABLED=false
INTERVIEW_RECORDING_S3_BUCKET=
INTERVIEW_RECORDING_S3_REGION=ap-south-1
INTERVIEW_RECORDING_S3_PREFIX=interviews/
# Credentials for an IAM user limited to this bucket; any AWS default credential source also works.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: S3-compatible storage endpoint. Leave empty for AWS S3.
INTERVIEW_RECORDING_S3_ENDPOINT=
