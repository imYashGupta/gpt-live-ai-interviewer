OPENAI_API_KEY=
APP_PASSCODE=
SQLITE_DATABASE_PATH=.data/interviews.sqlite
INTERVIEW_EVALUATION_MODEL=

# Independent interview service: opt-in, synthetic provider, zero billable usage.
INTERVIEW_SERVICE_ENABLED=false
# Use a dedicated database on your existing Herd PostgreSQL server.
INTERVIEW_DATABASE_URL=
# Generate 32 random bytes as 64 hex characters; keep stable across API/worker restarts.
INTERVIEW_SERVICE_ENCRYPTION_KEY=
INTERVIEW_SERVICE_ORIGIN=https://interviewer.test
# Exact public webhook hostnames, comma-separated. No wildcards or private networks.
INTERVIEW_WEBHOOK_HOSTS=
# Optional separate test database on the SAME server; tests use a temporary schema.
INTERVIEW_TEST_DATABASE_URL=

# Unbilled live pilot. Both API and worker need identical settings and OPENAI_API_KEY.
INTERVIEW_LIVE_ENABLED=false
INTERVIEW_LIVE_ACCOUNT_IDS=
# Leave capacity for assessment and delivery while live capture runs.
INTERVIEW_WORKER_CONCURRENCY=4
